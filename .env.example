# Copy to .env and adjust. Every line is optional unless noted.

# Where the app listens. 127.0.0.1 = this machine only; 0.0.0.0 = the whole network.
GAZELAB_BIND=127.0.0.1
GAZELAB_PORT=8000

# Limits
GAZELAB_MAX_UPLOAD_MB=300          # per dataset (all files of one upload together)
GAZELAB_MAX_ROWS=3000000           # samples per dataset
GAZELAB_UPLOAD_TTL_HOURS=168       # uploads are deleted this long after their last use; 0 keeps them forever
GAZELAB_CACHE_STEPS=64             # step results kept in memory per worker
GAZELAB_WORKERS=1                  # worker processes; 2-4 for a class working at the same time

# 1 = build for CPUs without AVX2 (the log says "Missing required CPU features"). Rebuild after changing.
GAZELAB_POLARS_COMPAT=0

# Only for compose.https.yaml (required there)
# GAZELAB_DOMAIN=gazelab.example.org
# GAZELAB_USER=class
# Create the hash with:  docker run --rm caddy:2 caddy hash-password --plaintext 'your password'
# Keep the single quotes: the hash contains $ signs.
# GAZELAB_PASSWORD_HASH='$2a$14$...'
